# Copy to `.env` and fill in. NEVER commit a real private key.
#
# cp .env.example .env

# --- Network ---
# Quai mainnet:
RPC_URL=https://rpc.quai.network
CHAIN_ID=9
# Orchard testnet:
# RPC_URL=https://orchard.rpc.quai.network
# CHAIN_ID=15000

# --- Deployer key ---
# Quai account private key. The corresponding address must start with 0x00 (Cyprus-1 zone)
# and hold QUAI for gas. On mainnet use a dedicated hot key — never your treasury key.
CYPRUS1_PK=

# --- PayWithQuai initializer config ---
# REQUIRED on mainnet: where platform fees are sent. The deploy script refuses to run on mainnet
# without it — fees are never silently defaulted to the deployer EOA. Must be in the same Quai
# zone as the deployment (Cyprus-1, 0x00...) and must accept native value without reverting.
# Use a dedicated treasury wallet or a Safe.
FEE_RECIPIENT=
# Platform fee in basis points (default 30 = 0.3%, 0 = no fee, max 500 = 5%).
FEE_BPS=30
# REQUIRED on mainnet: a real stablecoin address to allowlist at deploy time. MockStablecoin is
# never deployed to mainnet; on testnet the mock is allowlisted automatically.
STABLECOIN_ADDR=

# --- Upgrade governance (UUPS) ---
# REQUIRED on mainnet: the deploy script deploys a TimelockController (proposer/executor = this
# multisig) and transfers proxy ownership to it, so upgrades require multisig approval + a time
# delay. Use a Gnosis Safe here.
MULTISIG_ADDR=
# Timelock delay in seconds before a scheduled upgrade can execute (default 172800 = 48h,
# minimum enforced on mainnet: 86400 = 24h).
TIMELOCK_MIN_DELAY=172800

# --- Emergency pause ---
# REQUIRED on mainnet: an independent guardian that can pause() payments in an emergency but can
# never unpause or change any other state. A second multisig or trusted cold wallet works.
PAUSE_GUARDIAN_ADDR=

# --- payDemo.js only ---
# Merchant payout wallet used by the end-to-end demo (defaults to the deployer if unset).
MERCHANT_ADDR=

# =============================================================================================
# --- Standard EVM chains (testnets) ---
# Parallel ethers-based toolchain (scripts/evm/) for standard EVM testnets, alongside the Quai
# deployment above. Quai deployment/config is unaffected by anything in this section.
# =============================================================================================

# --- Deployer key ---
# A plain EVM private key — any address format works (no Cyprus-1 zone requirement). Use a
# fresh, testnet-only key funded from a faucet; NEVER your Quai CYPRUS1_PK or a mainnet key.
EVM_DEPLOYER_PK=

# --- RPC endpoints ---
# Both fall back to public defaults in hardhat.config.js if unset.
# Robinhood Chain testnet (chainId 46630):
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Base Sepolia (chainId 84532):
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Shared initializer / governance config ---
# scripts/evm/deploy.js and scripts/evm/payDemo.js reuse the SAME variables as the Quai script
# above: FEE_RECIPIENT, FEE_BPS, MULTISIG_ADDR, PAUSE_GUARDIAN_ADDR, TIMELOCK_MIN_DELAY, and
# MERCHANT_ADDR (payDemo.js only — must equal the deployer address if set; registerOrder always
# records msg.sender as the merchant). FEE_RECIPIENT defaults to the deployer on these testnets
# (there is no mainnet path through scripts/evm/ yet — see MAINNET_CHAIN_IDS in deploy.js).

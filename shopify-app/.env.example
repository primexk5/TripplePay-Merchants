PORT=3002
NODE_ENV=development

# Shopify app credentials (Partner Dashboard → Apps → your app → API credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# OAuth redirect_uri must match the app setting exactly: <SHOPIFY_APP_URL>/auth/callback
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_SCOPES=read_orders,write_orders

# The Pay with Quai gateway this connector talks to.
GATEWAY_BASE_URL=https://api.example.com
GATEWAY_FIAT_CURRENCY=USD

# LEGACY shared credentials — a fallback for stores that have not saved their own. Every store
# using them bills to the SAME merchant account, so this is single-tenant only. Real deployments
# leave these UNSET and have each merchant enter their own credentials at /settings (they paste the
# key issued by POST /v1/me/apikeys plus their webhook secret; the connector stores them sealed).
# GATEWAY_MERCHANT_KEY=qmkey_...
# GATEWAY_WEBHOOK_SECRET=whsec_...

# Persistence. Without DATABASE_URL the connector uses a single-process JSON file whose Shopify
# access tokens are LOST ON RESTART — every store goes offline until each merchant reinstalls.
DATABASE_URL=
# Most hosted providers require TLS. Or put ?sslmode=require in DATABASE_URL.
DATABASE_SSL=false
# Only used when DATABASE_URL is empty.
STORE_PATH=./data

# AES-256-GCM key protecting per-store gateway credentials at rest. REQUIRED when NODE_ENV=production.
#   generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be STABLE across restarts and replicas. Changing it makes every stored store credential
# unreadable — each merchant must re-enter theirs on the settings page.
CONNECTOR_ENCRYPTION_KEY=

# How long an issued OAuth `state` stays valid before an install is rejected as stale (default 10m).
OAUTH_STATE_TTL_MS=600000
# How often lapsed gateway quotes are reconciled into `expired` (default 30s).
EXPIRY_SWEEP_INTERVAL_MS=30000

# Dev helpers
LOG_PRETTY=false
# Allow http:// store domains in dev (Shopify install URLs require https)
ALLOW_INSECURE_SHOP_HOST=false
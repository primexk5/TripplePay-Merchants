PORT=3002
NODE_ENV=development

# Shopify app credentials (Partner Dashboard → Apps → your app → API credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# OAuth redirect_uri must match the app setting exactly: <SHOPIFY_APP_URL>/auth/callback
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_SCOPES=read_orders,write_orders

# The Pay with Quai gateway this connector talks to.
GATEWAY_BASE_URL=https://api.example.com
GATEWAY_MERCHANT_KEY=qmkey_...
GATEWAY_WEBHOOK_SECRET=whsec_...
GATEWAY_FIAT_CURRENCY=USD

# Local JSON persistence. Switch to Postgres before real traffic.
STORE_PATH=./data

# How long an issued OAuth `state` stays valid before an install is rejected as stale (default 10m).
OAUTH_STATE_TTL_MS=600000
# How often lapsed gateway quotes are reconciled into `expired` (default 30s).
EXPIRY_SWEEP_INTERVAL_MS=30000

# Dev helpers
LOG_PRETTY=false
# Allow http:// store domains in dev (Shopify install URLs require https)
ALLOW_INSECURE_SHOP_HOST=false
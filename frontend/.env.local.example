# Copy to `.env.local` and fill in.  cp .env.local.example .env.local

# ── Quai (unchanged) ──────────────────────────────────────────────────────────────────────────
# Quai MAINNET RPC used by the frontend (browser wallet + order status reads).
NEXT_PUBLIC_RPC_URL=https://rpc.quai.network
# Selects which configured chain (see NEXT_PUBLIC_CHAINS below) is the default for chain-less
# contexts — must match one of the table's chainIds, or it's ignored and the chain marked
# "default" (or the first configured chain) is used. Quai (9) today.
NEXT_PUBLIC_CHAIN_ID=9

# Contract addresses (from contracts/deployments/cyprus1.json after mainnet deploy).
NEXT_PUBLIC_PAYWITHQUAI_ADDRESS=
NEXT_PUBLIC_MUSDQ_ADDRESS=

# Optional token overrides — canonical mainnet addresses are built in (see src/lib/currencies.ts):
# NEXT_PUBLIC_USDT_ADDRESS=0x0049F7cbCa3556C2DfaE62Aafa7015F99de1b8f5
# NEXT_PUBLIC_WQUAI_ADDRESS=0x006C3e2AaAE5DB1bCd11A1a097cE572312EADdBB

# ── Additional / other chains ─────────────────────────────────────────────────────────────────
# frontend/src/lib/chains.ts is the source of truth for every chain the frontend can point a
# wallet at (chainId, kind "quai"|"evm", name, rpcUrl, contractAddress, explorerUrl,
# nativeCurrency). Robinhood Chain testnet (46630) is already built in with real values.
#
# NEXT_PUBLIC_CHAINS lets you add or override chains without a code change — an inline JSON array
# of the same shape as backend/chains.example.json, merged OVER the built-ins by chainId (same
# chainId replaces that entry, a new chainId adds one). Per-chain RPCs and contract addresses now
# live HERE (or in the built-ins), not as one flat NEXT_PUBLIC_RPC_URL/NEXT_PUBLIC_PAYWITHQUAI_ADDRESS
# pair — those two vars remain Quai-specific only.
#
# NEXT_PUBLIC_CHAINS=[{"chainId":84532,"slug":"base-sepolia","name":"Base Sepolia (testnet)","kind":"evm","rpcUrl":"https://sepolia.base.org","contractAddress":"0x...","explorerUrl":"https://sepolia.basescan.org","nativeCurrency":{"name":"Ether","symbol":"ETH","decimals":18}}]
#
# Robinhood Chain testnet overrides, if you don't want to touch chains.ts's built-in values:
# NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# NEXT_PUBLIC_ROBINHOOD_TESTNET_PAYWITHQUAI_ADDRESS=0xe2C0d033102B7ad963deC4b44B5e1e94bca1385f
# NEXT_PUBLIC_ROBINHOOD_TESTNET_STABLECOIN_ADDRESS=0xb34b57F6e78200a4D403544e4c23D7d2D5f7D66C

# Relayer API base URL(s), comma-separated for failover (first reachable wins). One backend now
# serves every configured chain — no per-chain backend URL needed.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Relayer admin key for the server-side admin proxy (merchant onboarding / demo list).
# Server-only: consumed by app/api/admin/[...path]/route.ts — NEVER prefix with NEXT_PUBLIC_,
# or it ships to the browser bundle. Must match ADMIN_API_KEY in backend/.env.
ADMIN_API_KEY=

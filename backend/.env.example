# Copy to `.env` and fill in.  cp .env.example .env

# --- Chain ---
# Quai MAINNET zone RPC. Must be the SAME zone the PayWithQuai proxy was deployed to (Cyprus-1).
RPC_URL=https://rpc.quai.network
CHAIN_ID=9
# Orchard testnet (if needed):
# RPC_URL=https://orchard.rpc.quai.network
# CHAIN_ID=15000

# PayWithQuai PROXY address (the `payWithQuai` field in contracts/deployments/<network>.json).
PAYWITHQUAI_ADDRESS=

# Block to start indexing from. Set to the proxy's deployment block to capture history from
# launch. Leave blank to start from (current head - CONFIRMATIONS) on first boot.
START_BLOCK=

# --- Relayer tuning ---
# How many confirmations before a PaymentReceived event is treated as final (reorg protection).
CONFIRMATIONS=12
# How often to poll for new blocks/logs, in milliseconds.
POLL_INTERVAL_MS=5000
# Max block span per getLogs request (chunking for large catch-up ranges).
MAX_BLOCK_RANGE=2000

# --- Webhook delivery ---
# Max delivery attempts before a webhook is marked permanently failed.
WEBHOOK_MAX_ATTEMPTS=10
# Base backoff (ms) for retries; grows exponentially with jitter up to WEBHOOK_MAX_BACKOFF_MS.
WEBHOOK_BASE_BACKOFF_MS=5000
WEBHOOK_MAX_BACKOFF_MS=3600000
# Per-request timeout when POSTing to a merchant endpoint.
WEBHOOK_TIMEOUT_MS=10000
# SSRF guard. When false (default/production), webhook URLs must be https and must not resolve to a
# private/loopback/reserved address (re-checked before every delivery; redirects are not followed).
# Set true ONLY for local dev against an http://localhost receiver.
WEBHOOK_ALLOW_INSECURE_URLS=false

# --- HTTP API ---
PORT=8080
# Number of reverse proxies in front of the app (0 = none). Set to the exact hop count of your
# infrastructure so req.ip (rate limiter keys) is the real client address, never blindly 1.
TRUST_PROXY=0
# Realm bound into the wallet-login challenge message alongside CHAIN_ID — a signature captured on
# one deployment can never replay against another deployment with a different realm/chain id.
LOGIN_REALM=quai-merchant
# Comma-separated browser origins allowed to call the API, or * for any (local dev).
CORS_ORIGINS=*
# Bearer token required for admin endpoints (merchant onboarding). Generate a long random value.
ADMIN_API_KEY=
# Optional ERC-20 allowlist for payment links (comma-separated addresses). Native QUAI is always
# allowed. Unset/empty = any 20-byte token address may be used.
# Example (canonical mainnet tokens): USDT + WQUAI
# ACCEPTED_TOKENS=0x0049F7cbCa3556C2DfaE62Aafa7015F99de1b8f5,0x006C3e2AaAE5DB1bCd11A1a097cE572312EADdBB
# Rate limit for the unauthenticated, RPC-backed GET /v1/orders/... route: max requests per client
# IP per window (protects the upstream Quai RPC). Exceeding it returns 429 with Retry-After.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# --- Qi checkout (UTXO-ledger payments) ---
# Feature-gated: the whole Qi surface is OFF unless BOTH QI_MNEMONIC and QI_RPC_URL are set.
# When off, order APIs return `qi: null`, no addresses are ever derived, and the Qi indexer is idle.
#   QI_MNEMONIC: the merchant's Qi HD wallet seed phrase. Each order gets a deterministic
#                one-time receive address derived from it; reconcile against these on payout.
#   QI_RPC_URL:  a Quai Qi-chain JSON-RPC endpoint for the SAME zone the addresses are derived on.
#                Mainnet Cyprus-1: https://rpc.quai.network/cyprus1 (the SDK derives Cyprus1 only).
#   QI_QITS_PER_QUAI:      qits charged per 1 QUAI of order value (1000 qits = 1 Qi).
#   QI_POLL_INTERVAL_MS:   how often the Qi indexer polls pending orders' addresses for UTXOs.
# QI_MNEMONIC=
# QI_RPC_URL=
# QI_QITS_PER_QUAI=1000
# QI_POLL_INTERVAL_MS=8000

# --- LOCAL-DEV ONLY: Qi demo affordances ---
# Refuse to load with NODE_ENV=production. Both still require the admin bearer token.
# QI_DEV_SIMULATE=false     # true: synthesize /v1/orders for the demo merchant,
#                           #      and enable POST /v1/dev/qi-settle/<orderId>
# QI_DEV_DEMO_MERCHANT=     # 0x merchant address to fabricate orders for in QI_DEV_SIMULATE mode

# --- Storage / logging ---
# Local single-process store: an atomically-written JSON file (no external dependency).
DATABASE_PATH=./data/relayer.db
# Set DATABASE_URL to use PostgreSQL instead (required for Railway / multiple instances).
# Railway sets this automatically when a Postgres service is attached to the backend.
DATABASE_URL=
# Force TLS for Postgres. Railway requires it; auto-detected from sslmode=... in DATABASE_URL
# when present. Set true if your URL omits sslmode.
DATABASE_SSL=false
# trace | debug | info | warn | error
LOG_LEVEL=info
# Pretty-print logs (true for local dev; leave false/JSON in production).
LOG_PRETTY=false

# =============================================================================================
# --- Multi-chain configuration ---
# ONE backend process now serves ALL configured chains, with ONE database (replaces the "one
# process per chain" model from an earlier iteration — see src/chains.ts). Every chain's own
# settings (RPC URL, contract address, confirmations, poll interval, per-chain token allowlist,
# ...) live in a JSON file/string, not in individual env vars:
#
#   CHAINS_JSON=<inline JSON array>       highest precedence
#   CHAINS_CONFIG_PATH=<path to a .json file>   used if CHAINS_JSON is unset
#   (neither set, and ./chains.json doesn't exist)  -> legacy single-chain fallback (see below)
#
# See backend/chains.example.json for a ready-to-use three-chain example (Quai mainnet as
# default, Robinhood Chain testnet enabled, Base Sepolia present but disabled) and
# backend/README.md for the full field reference, how to add a chain, and how per-chain
# confirmations should be tuned. A couple of quick examples:
#
#   CHAINS_CONFIG_PATH=./chains.json
# or, inline (no file):
#   CHAINS_JSON=[{"id":"quai","chainId":9,"kind":"quai","name":"Quai","rpcUrl":"https://rpc.quai.network/cyprus1","contractAddress":"0x0072174EF6d0C2EB605449b0014169D104c42BbC","confirmations":12,"enabled":true,"default":true}]
#
# LEGACY SINGLE-CHAIN VARS STILL WORK: if you set none of the above (and no ./chains.json file
# exists), this deployment behaves EXACTLY as it did before multi-chain support existed — a
# single chain is synthesized from RPC_URL, CHAIN_ID, PAYWITHQUAI_ADDRESS, CHAIN_KIND,
# START_BLOCK, CONFIRMATIONS, POLL_INTERVAL_MS, MAX_BLOCK_RANGE and ACCEPTED_TOKENS (all defined
# above in this file) — nothing to change for an existing single-chain deployment.
#
# CHAIN_KIND is DEPRECATED (a boot-time warning points here) but kept working indefinitely for
# that legacy fallback path only — once CHAINS_JSON/CHAINS_CONFIG_PATH is set, each chain
# declares its own "kind" in the JSON instead and CHAIN_KIND is ignored.
# =============================================================================================
CHAINS_JSON=
CHAINS_CONFIG_PATH=

# --- Local multi-chain example: Quai + Robinhood Chain testnet, one process, one database ---
# Uncomment to run BOTH chains from this single backend (see backend/chains.example.json for the
# full field list — RPC_URL/CHAIN_ID/PAYWITHQUAI_ADDRESS above become unused once this is set):
#
# CHAINS_CONFIG_PATH=./chains.json
#
# Then create ./chains.json (or copy chains.example.json and delete the base-sepolia entry) with
# at minimum:
#   [
#     { "id": "quai", "chainId": 9, "kind": "quai", "name": "Quai",
#       "rpcUrl": "https://rpc.quai.network/cyprus1",
#       "contractAddress": "0x0072174EF6d0C2EB605449b0014169D104c42BbC",
#       "confirmations": 12, "enabled": true, "default": true },
#     { "id": "robinhood-testnet", "chainId": 46630, "kind": "evm", "name": "Robinhood Chain testnet",
#       "rpcUrl": "https://rpc.testnet.chain.robinhood.com/rpc",
#       "contractAddress": "0xe2C0d033102B7ad963deC4b44B5e1e94bca1385f",
#       "startBlock": 120942283, "confirmations": 20, "enabled": true }
#   ]
# Both chains then share this ONE process's PORT/DATABASE_PATH/ADMIN_API_KEY/LOGIN_REALM/etc.
# above — that is the point of the new architecture (see backend/README.md "Adding a chain").
#
# Local-dev only: point a merchant's webhookUrl at http://localhost:4000/webhook (see
# scripts/devWebhookReceiver.js) — the SSRF guard otherwise requires https + a public host.
# WEBHOOK_ALLOW_INSECURE_URLS=true

# =============================================================================================
# E-commerce gateway (fiat-quoted prefilled orders for shop plugins — see shopify-app/)
# =============================================================================================
# Quai-only: the gateway settles on the deployment's DEFAULT chain and returns 501 when that chain
# isn't Quai (Qi is a Quai-only UTXO rail and the pricing feed below is keyed to Quai). To enable
# it on a multi-chain deployment, make the Quai chain the default in CHAINS_JSON.

# Live QUAI<->fiat rate feed for POST /v1/gateway/orders. A CoinGecko-style `simple/price` JSON
# that returns a "quai-network" object, e.g.
#   https://api.coingecko.com/api/v3/simple/price?ids=quai-network&vs_currencies=usd,ngn
# Cached for GATEWAY_RATE_TTL_MS; on fetch failure the fixed GATEWAY_FALLBACK_* rates below are
# used instead, so an unreachable feed degrades rather than failing a customer's checkout.
# GATEWAY_RATE_URL=

# How long a fetched rate is cached before the next quote re-fetches it.
# GATEWAY_RATE_TTL_MS=60000

# Fixed fallback rates (fiat per 1 QUAI), used when GATEWAY_RATE_URL is unset or unreachable.
# With neither a live feed nor these set, gateway orders are rejected with "no rate available".
# GATEWAY_FALLBACK_USD_PER_QUAI=
# GATEWAY_FALLBACK_NGN_PER_QUAI=

# Default markup over the market rate for merchants who haven't set settings.quaiMarkupBps in
# their dashboard settings. Basis points: 100 = +1%. Applied then rounded UP to wei, so a shop
# is never underpaid.
# GATEWAY_MARKUP_BPS_DEFAULT=0

# Public origin of the payment page (e.g. https://pay.example.com), used to build the
# checkoutUrl a gateway order returns. Unset, the backend derives it from the request
# (protocol + host) — set it explicitly behind a proxy so links stay correct.
# PUBLIC_BASE_URL=

# Gasless order registration for the gateway's QUAI method. The backend signs
# PayWithQuai.registerOrderFor on the merchant's behalf so a shop never needs QUAI in its payout
# wallet just to register an order. Requires the deployed proxy to have been upgraded with the
# relayer set AND this address registered via setRelayer(address, true) — until both are done,
# the QUAI gateway method fails and only token:'qi' works.
# RELAYER_PRIVATE_KEY=

{
  "name": "pay-with-quai-backend",
  "version": "0.1.0",
  "description": "Relayer + API for the Pay with Quai checkout system: watches PayWithQuai settlement events on Quai, confirms finality, and delivers signed webhooks to merchants.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook-receiver": "tsx src/dev/webhookReceiver.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "ipaddr.js": "^1.9.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "quais": "1.0.0-alpha.56",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
